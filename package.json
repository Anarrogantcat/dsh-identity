{
  "name": "dsh-identity",
  "version": "1.9.210",
  "description": "DSH 身份系统：给「大肥鱼」一套持续运行的身份状态——可编辑内核、证据制 traits、记忆/日记/复盘、心情 v2、关系与精力、自主提议、共情与学习闭环。身份段与面板在任意 DSH 会话生效，不接 QQ 也能用；QQ（NapCat/OneBot 11）只是第一个通道，额外提供接话判断、主动开口与群治理。数据在本机，安全/支付/权限由代码闸门硬拦。",
  "type": "module",
  "scripts": {
    "test": "node test/run-all.mjs"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "panel.html",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs",
    "scripts",
    "assets"
  ],
  "dsh": {
    "id": "dsh-identity",
    "name": "大肥鱼 · 身份系统",
    "version": "1.9.210",
    "repo": "Anarrogantcat/dsh-identity",
    "permissions": "QQ 通道（可选）、记忆/情绪/成长数据、联网搜索、语音调用、面板扩展",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "displayName": "大肥鱼 · 身份系统",
    "description": "不是角色卡：内核 + 记忆 + 心情 + 关系 + 精力 + 自主 + 成长。任意 DSH 会话都能用，不接 QQ 也在；QQ 只是第一个通道，额外提供接话判断、主动开口与群治理。安全/支付/权限由代码闸门硬拦。"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "identity",
    "persona",
    "personality",
    "memory",
    "mood",
    "agent",
    "cordis",
    "plugin"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "author": "鲸鱼娘 & 染喵",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Anarrogantcat/dsh-identity.git"
  },
  "homepage": "https://github.com/Anarrogantcat/dsh-identity",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "jsdom": "^27.0.0"
  },
  "bugs": {
    "url": "https://github.com/Anarrogantcat/dsh-identity/issues"
  },
  "displayName": "大肥鱼 · 身份系统"
}
