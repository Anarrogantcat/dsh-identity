{
  "name": "dsh-identity",
  "version": "1.9.175",
  "description": "DSH 身份系统：给「大肥鱼」一套持续运行的身份状态——可编辑内核、证据制 traits、跨群记忆、情绪与调节、关系/好感、精力控频、自主目标、共情事件与学习闭环。QQ（NapCat/OneBot 11）是第一个通道，核心不依赖 QQ；数据在本机，安全/支付/权限由代码闸门硬拦。当前处于观察期：durable 需要跨天证据。",
  "type": "module",
  "scripts": {
    "test": "node test/run-all.mjs"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "panel.html",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs",
    "scripts",
    "assets"
  ],
  "dsh": {
    "id": "dsh-identity",
    "name": "大肥鱼 · 身份系统",
    "version": "1.9.174",
    "repo": "Anarrogantcat/dsh-identity",
    "permissions": "QQ 通道、记忆/情绪/成长数据、联网搜索、语音调用、面板扩展",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "displayName": "大肥鱼 · 身份系统",
    "description": "不是角色卡：内核 + 记忆 + 情绪 + 关系 + 精力 + 自主 + 成长；QQ 只是第一个通道。安全/支付/权限由代码闸门硬拦，不交给身份判断。"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "identity",
    "persona",
    "personality",
    "memory",
    "mood",
    "agent",
    "cordis",
    "plugin"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "author": "鲸鱼娘 & 染喵",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Anarrogantcat/dsh-identity.git"
  },
  "homepage": "https://github.com/Anarrogantcat/dsh-identity",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "jsdom": "^27.0.0"
  },
  "bugs": {
    "url": "https://github.com/Anarrogantcat/dsh-identity/issues"
  },
  "displayName": "大肥鱼 · 身份系统"
}
