{
  "name": "dsh-identity",
  "version": "1.3.4",
  "description": "DSH 身份系统插件（大肥鱼）：可编辑内核 + 证据制 traits + 事件流/记忆双卡/日记复盘 + 心情 v2（语气·内容·行为）+ 自主提议 + 治理与能力运行时；QQ 是第一个通道，核心不依赖它。",
  "type": "module",
  "scripts": {
    "test": "node test/run-all.mjs"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "panel.html",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs",
    "scripts",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "identity",
    "persona",
    "personality",
    "memory",
    "mood",
    "agent",
    "cordis",
    "plugin"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "author": "鲸鱼娘 & 染喵",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Anarrogantcat/dsh-identity.git"
  },
  "homepage": "https://github.com/Anarrogantcat/dsh-identity",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "jsdom": "^27.0.0"
  },
  "bugs": {
    "url": "https://github.com/Anarrogantcat/dsh-identity/issues"
  }
}
